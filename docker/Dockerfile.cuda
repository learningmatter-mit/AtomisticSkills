# The generative image: several uv projects side by side (adit, diffcsp,
# mattergen), built from the same venv/<venv>/uv.lock files a host install
# uses, on a CUDA toolkit image.
#
# On amd64 the image installs PyG's wheels, which need glibc 2.32: hosts older
# than that (EL8) use the image. On arm64 PyG publishes no wheels for these
# compiled extensions (torch-scatter, torch-sparse, torch-cluster), so they are
# built from source here, against each environment's torch. That needs nvcc, and FORCE_CUDA=1: the build sees
# no GPU, and without it the extensions silently compile without their CUDA
# kernels ("Not compiled with CUDA support" at the first GPU call).
#
# Build:
#   docker buildx build -f docker/Dockerfile.cuda --platform linux/amd64,linux/arm64 \
#     --build-arg VENVS="adit diffcsp mattergen" --build-arg IMAGE_NAME=generative \
#     -t ghcr.io/learningmatter-mit/atomisticskills-generative:dev .
ARG BASE_IMAGE=nvidia/cuda:13.0.1-devel-ubuntu24.04

# Only the selected projects' pyproject.toml and uv.lock pass to the build
# stage. COPY --from is keyed on content, so a change anywhere else under venv/
# (another project's lock, venv/run) leaves the compiled extensions cached; on
# arm64 that compile is most of the build time.
FROM ${BASE_IMAGE} AS locks
ARG VENVS="adit diffcsp mattergen"
COPY venv/ /tmp/venv-context/
RUN set -eux; \
    for v in ${VENVS}; do \
        mkdir -p /locks/$v; \
        cp /tmp/venv-context/$v/pyproject.toml /tmp/venv-context/$v/uv.lock /locks/$v/; \
    done

FROM ${BASE_IMAGE}

ARG IMAGE_NAME=generative
ARG VENVS="adit diffcsp mattergen"
# GPU architectures the extensions are compiled for: GB10 / DGX Spark is sm_121.
ARG TORCH_CUDA_ARCH_LIST="12.1"
# Parallel compile jobs per extension build (ninja). Builds run one at a time
# (UV_CONCURRENT_BUILDS=1): each nvcc job takes a few GB of memory.
ARG MAX_JOBS=4

ENV DEBIAN_FRONTEND=noninteractive \
    REPO_DIR=/opt/atomisticskills \
    UV_PYTHON_INSTALL_DIR=/opt/uv/python \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CUDA_HOME=/usr/local/cuda

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git util-linux build-essential \
        # RDKit's drawing code (rdkit.Chem.Draw, via its bundled cairo) links
        # the X11 client and render libraries, which its wheel does not bundle.
        libx11-6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.10.9 /uv /uvx /usr/local/bin/

WORKDIR ${REPO_DIR}

# The environments first, so edits to code do not invalidate the multi-GB
# layers. Each image carries only the projects VENVS names.
COPY pyproject.toml VERSION ${REPO_DIR}/
COPY --from=locks /locks/ ${REPO_DIR}/venv/

# Images carry the CUDA 13 build of torch (cu130).
RUN --mount=type=cache,target=/root/.cache/uv \
    set -eux; \
    for v in ${VENVS}; do \
        echo "== ${v} (TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST})"; \
        FORCE_CUDA=1 TORCH_CUDA_ARCH_LIST="${TORCH_CUDA_ARCH_LIST}" MAX_JOBS="${MAX_JOBS}" \
        UV_CONCURRENT_BUILDS=1 \
            uv sync --frozen --project venv/$v --extra cu130 --no-dev \
            --no-install-package atomisticskills; \
    done

COPY src/ ${REPO_DIR}/src/
COPY skills/ ${REPO_DIR}/skills/
COPY venv/run venv/servers.tsv venv/platforms.tsv ${REPO_DIR}/venv/
COPY docker/entrypoint.sh docker/images.json docker/render.py docker/NOTICE.md ${REPO_DIR}/docker/
RUN --mount=type=cache,target=/root/.cache/uv \
    set -eux; \
    for v in ${VENVS}; do \
        uv sync --frozen --project venv/$v --extra cu130 --no-dev; \
        # The extensions must have their CUDA kernels (see the header).
        venv/$v/.venv/bin/python -c "import torch, torch_scatter, torch_sparse, torch_cluster; \
assert torch.ops.torch_scatter.cuda_version() > 0, 'torch_scatter built without CUDA'; \
assert torch.ops.torch_sparse.cuda_version() > 0, 'torch_sparse built without CUDA'; \
assert torch.ops.torch_cluster.cuda_version() > 0, 'torch_cluster built without CUDA'; \
print('${v}: PyG extensions with CUDA', torch.ops.torch_scatter.cuda_version())"; \
        venv/$v/.venv/bin/python -c "import importlib.util as u; u.find_spec('rdkit') and __import__('rdkit.Chem.Draw')"; \
    done; \
    first="$(echo ${VENVS} | awk '{print $1}')"; \
    venv/${first}/.venv/bin/python docker/render.py server-map "${IMAGE_NAME}" \
        > docker/server-map.txt; \
    cat docker/server-map.txt; \
    chmod +x docker/entrypoint.sh venv/run

# Each server runs in its own environment (docker/server-map.txt). A command
# runs in the environment named by ATOMISTIC_VENV, which venv/run passes; the
# first one by default.
# The toolkit is for compiling the extensions only. At run time each
# environment uses the CUDA libraries of its own torch wheels, which the base
# image's /usr/local/cuda/lib64 on LD_LIBRARY_PATH would shadow (DiffCSP++'s
# torch 2.10 needs cuBLAS 13.1, the toolkit ships 13.0: CUBLAS_STATUS_INVALID_VALUE).
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64 \
    UV_NO_SYNC=1 \
    HF_HOME=/opt/model-cache/huggingface \
    TORCH_HOME=/opt/model-cache/torch \
    MATGL_CACHE=/opt/model-cache/matgl

RUN mkdir -p /opt/model-cache /work && chmod 777 /opt/model-cache /work
VOLUME ["/opt/model-cache"]
WORKDIR /work

ENTRYPOINT ["/opt/atomisticskills/docker/entrypoint.sh"]
